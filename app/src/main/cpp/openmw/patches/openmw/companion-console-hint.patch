     void WindowManager::updateControllerButtonsOverlay()
     {
 #ifdef __ANDROID__
+        // COMPANION: the console gets an unconditional hint of its own, ahead of every gate below.
+        //
+        // The console has no controller support at all -- no getControllerButtons, no
+        // onControllerButtonEvent -- so it never reached this bar by the ordinary route, and yet it
+        // IS closed with a controller: Start is A_GameMenu, and ActionManager::toggleMainMenu tests
+        // isConsoleMode() before anything else and toggles the console back off. On this device the
+        // console is opened from the OTHER screen (the DS keyboard's ` key), so without a hint there
+        // is nothing on screen saying how to get rid of it.
+        //
+        // Deliberately NOT subject to companionHudControllerTooltips() (the "Controller tooltips"
+        // HUD toggle) nor to Settings::gui().mControllerMenus: this is not a tooltip for a menu the
+        // player is navigating, it is the only signposted exit from a window covering the screen, so
+        // it must not be something they can switch off and then be stuck behind.
+        // mControllerButtonsOverlay is constructed unconditionally, so using it while controller
+        // menus are off is safe.
+        //
+        // Returning early also PINS the hint: several windows call this while the console is open
+        // (journal, map, every modal close) and each would otherwise overwrite the bar with its own
+        // buttons while the console still had focus.
+        if (mConsole && mConsole->isVisible() && mControllerButtonsOverlay)
+        {
+            static ControllerButtons sConsoleButtons = [] {
+                ControllerButtons buttons;
+                // mView, NOT mMenu. The two are named the opposite way round from what the fields
+                // suggest: sButtonDefs maps Button_View to SDL_CONTROLLER_BUTTON_START and
+                // Button_Menu to SDL_CONTROLLER_BUTTON_BACK. Start is what A_GameMenu is bound to
+                // and therefore what closes the console.
+                //
+                // The text names the button as well as the action, which the other windows' hints
+                // do not need to: the icon this bar draws for START is not recognisable as Start on
+                // this device, so the label has to carry the instruction on its own.
+                buttons.mView = "Press Start to Close Console";
+                return buttons;
+            }();
+            mControllerButtonsOverlay->setButtons(&sConsoleButtons);
+            if (mInventoryTabsOverlay)
+                mInventoryTabsOverlay->setVisible(false);
+            return;
+        }
+
