+    void CreateClassDialog::buildControllerNav()
+    {
+        // Column 0 is the specialization row plus the two favourite attributes; columns 1 and 2 are
+        // the major and minor skills. Each column ends with the dialog button sitting below it, so
+        // pressing Down off the bottom of a column lands on that column's button and Up from the
+        // button returns to the field above it. The class-name edit box spans the full width above
+        // all three columns, so it leads every column - Up from the top field reaches it whichever
+        // column you are in, and moving sideways along that row is a no-op on the same widget.
+        const NavItem name{ mEditName, NavKind::Name };
+
+        mNavColumns[0] = { name, { mSpecializationName, NavKind::Specialization },
+            { mFavoriteAttribute0, NavKind::Attribute }, { mFavoriteAttribute1, NavKind::Attribute },
+            { mButtons[0], NavKind::Description } };
+
+        mNavColumns[1].reserve(mMajorSkill.size() + 2);
+        mNavColumns[1].push_back(name);
+        for (const Widgets::MWSkillPtr& skill : mMajorSkill)
+            mNavColumns[1].push_back({ skill, NavKind::Skill });
+        mNavColumns[1].push_back({ mButtons[1], NavKind::Back });
+
+        mNavColumns[2].reserve(mMinorSkill.size() + 2);
+        mNavColumns[2].push_back(name);
+        for (const Widgets::MWSkillPtr& skill : mMinorSkill)
+            mNavColumns[2].push_back({ skill, NavKind::Skill });
+        mNavColumns[2].push_back({ mButtons[2], NavKind::Ok });
+
+        // Open on OK, as this dialog did before it had grid navigation: the defaults are playable,
+        // so A straight away still accepts them.
+        mNavColumn = 2;
+        mNavRow = mNavColumns[2].size() - 1;
+    }
+
+    bool CreateClassDialog::navItemIsButton(size_t column, size_t row) const
+    {
+        return column < mNavColumns.size() && !mNavColumns[column].empty()
+            && row == mNavColumns[column].size() - 1;
+    }
+
+    void CreateClassDialog::highlightNavItem(size_t column, size_t row, bool focused)
+    {
+        if (column >= mNavColumns.size() || row >= mNavColumns[column].size())
+            return;
+
+        // Three widget types, three separate setStateSelected() overloads that share no base:
+        // MWSkill and MWAttribute recolour their name label, MyGUI::Button uses the skin's
+        // "*_checked" states (SandTextButton/MW_Button both define them).
+        MyGUI::Widget* widget = mNavColumns[column][row].mWidget;
+        if (widget == nullptr)
+            return;
+        if (auto* skill = widget->castType<Widgets::MWSkill>(false))
+            skill->setStateSelected(focused);
+        else if (auto* attribute = widget->castType<Widgets::MWAttribute>(false))
+            attribute->setStateSelected(focused);
+        else if (auto* edit = widget->castType<MyGUI::EditBox>(false))
+        {
+            // An EditBox has no setStateSelected(), so recolour its text the same way MWSkill and
+            // MWAttribute recolour theirs. Checked before Button: both derive from TextBox, but an
+            // EditBox is not a Button, so the Button branch below would simply miss it.
+            const TextColours& colours = MWBase::Environment::get().getWindowManager()->getTextColours();
+            edit->setTextColour(focused ? colours.link : colours.normal);
+        }
+        else if (auto* button = widget->castType<MyGUI::Button>(false))
+            button->setStateSelected(focused);
     }
 
