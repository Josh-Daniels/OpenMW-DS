+        // COMPANION (companion-map-stick-input.patch): ANALOG STICK STREAM for the DS map.
+        //
+        // Every other companion controller signal is a DISCRETE, payload-less step: the polls below
+        // emit COMPANION_NAV_SCROLL_*/SLIDER_* at a fixed ~16Hz whenever an axis is past 0.5, so a
+        // half-pushed stick is indistinguishable from a fully-pushed one. That is exactly right for
+        // moving a focus index one row at a time and exactly wrong for zooming and panning a map,
+        // which have to be continuous and speed-sensitive. So this is the one place a real axis
+        // MAGNITUDE crosses to Kotlin.
+        //
+        // It reports STATE, not events: the line carries where the sticks currently are, and the
+        // Compose side integrates it against real frame time (withFrameNanos). That split is what
+        // makes the motion smooth independently of how often this fires — which is rarely, because
+        // the value is QUANTIZED to 0.05 and change-detected, so holding a stick perfectly still
+        // emits nothing at all. Same reasoning as quantizeRemaining on COMPANION_ACTIVE_EFFECTS: a
+        // raw float would differ every frame and put a 60Hz line stream on the wire for a motion
+        // nothing reads that finely.
+        //
+        // NOT in the COMPANION_NAV_ namespace on purpose. GameStateRepository.onRawLine routes
+        // anything containing "COMPANION_NAV_" into parseNav, which builds a seq-stamped NavEvent;
+        // this is neither payload-less nor an event, so it gets its own prefix and its own branch
+        // rather than an ordering rule someone has to remember.
+        //
+        // The deadzone is applied HERE, radially per stick (not per axis — a diagonal push must not
+        // need more travel than a cardinal one), and rescaled so the value ramps from 0 at the
+        // deadzone edge rather than jumping to 0.2. Doing it natively is what guarantees the idle
+        // case is silent: a worn stick resting at 0.06 would otherwise stream quantization noise
+        // for as long as the map is open. The response CURVE is deliberately left to Kotlin, where
+        // it can be retuned without a native rebuild.
+        {
+            constexpr float deadzone = 0.18f;
+            constexpr float step = 0.05f; // quantization; ~21 distinct values per axis
+            // Last EMITTED values, so drift accumulates against what Kotlin actually has rather
+            // than against the previous frame.
+            static float sLX = 0.f, sLY = 0.f, sRX = 0.f, sRY = 0.f;
+            static bool sStreaming = false;
+
+            auto quantize = [](float v) { return std::round(v / step) * step; };
+            // Radial deadzone + rescale, magnitude clamped to 1 (a full diagonal reads sqrt(2)).
+            auto applyStick = [&](SDL_GameControllerAxis ax, SDL_GameControllerAxis ay,
+                                   float& outX, float& outY) {
+                const float x = getAxisValue(ax);
+                const float y = getAxisValue(ay);
+                const float m = std::sqrt(x * x + y * y);
+                if (m <= deadzone)
+                {
+                    outX = 0.f;
+                    outY = 0.f;
+                    return;
+                }
+                const float scaled = std::min(1.f, (m - deadzone) / (1.f - deadzone));
+                outX = quantize(x / m * scaled);
+                outY = quantize(y / m * scaled);
+            };
+
+            if (companionDsMapActive())
+            {
+                float lx, ly, rx, ry;
+                applyStick(SDL_CONTROLLER_AXIS_LEFTX, SDL_CONTROLLER_AXIS_LEFTY, lx, ly);
+                applyStick(SDL_CONTROLLER_AXIS_RIGHTX, SDL_CONTROLLER_AXIS_RIGHTY, rx, ry);
+                if (!sStreaming || lx != sLX || ly != sLY || rx != sRX || ry != sRY)
+                {
+                    sStreaming = true;
+                    sLX = lx; sLY = ly; sRX = rx; sRY = ry;
+                    Log(Debug::Info) << "COMPANION_STICK:" << lx << "|" << ly << "|" << rx << "|" << ry;
                 }
             }
