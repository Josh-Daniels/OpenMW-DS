+    // ================= Companion (bottom-screen alchemy) =================
+    //
+    // PRESENTATION + INPUT FORWARDING ONLY. Every rule the DS screen appears to enforce is still
+    // enforced by MWMechanics::Alchemy underneath: the shared-effect-by->=2-ingredients combination
+    // rule and its slot ORDER, the four apparatus types, the mortar-and-pestle requirement, the
+    // duplicate-RefId ingredient rejection, the ready-status order, countPotionsToBrew(), and the
+    // per-potion success roll that destroys the ingredients whatever the outcome.
+
+    // The full state batch, streamed one small line per record (the browse list is bounded only by
+    // how many ingredients the player is carrying, so it must not ride a single line -- the
+    // 4096-byte stdout-flush truncation would silently cut it).
+    void AlchemyWindow::companionEmitState()
+    {
+        const MWWorld::Ptr player = MWMechanics::getPlayer();
+        if (player.isEmpty())
+            return;
+
+        const MWWorld::ESMStore& store = *MWBase::Environment::get().getESMStore();
+        MWBase::WindowManager* winMgr = MWBase::Environment::get().getWindowManager();
+
+        // Push the typed name into the Alchemy object BEFORE reading ready/maxBrew. This is the
+        // exact sequence onCreateButtonClicked uses (setPotionName then countPotionsToBrew), so the
+        // numbers shown are the ones Create would act on -- getReadyStatus() checks mPotionName, and
+        // countPotionsToBrew() returns 0 unless the status is Result_Success.
+        mAlchemy->setPotionName(mNameEdit->getCaption().asUTF8());
+
+        const float alchemySkill = player.getClass().getSkill(player, ESM::Skill::Alchemy);
+        const float fWortChanceValue
+            = store.get<ESM::GameSetting>().find("fWortChanceValue")->mValue.getFloat();
+
+        // getAlchemyFactor() = skill(Alchemy).modified + 0.1*Intelligence + 0.1*Luck. Vanilla's roll
+        // is `factor < Misc::Rng::roll0to99()`, i.e. a uniform integer in [0,99]; failure iff that
+        // integer exceeds the factor. So the success chance is the count of integers <= factor out
+        // of 100 -- floor(factor)+1, clamped. This only REPORTS the roll; nothing here changes it.
+        const float factor = mAlchemy->companionAlchemyFactor();
+        const int chance = std::clamp(static_cast<int>(std::floor(factor)) + 1, 0, 100);
+
+        const int ready = static_cast<int>(mAlchemy->companionReadyStatus());
+        const int maxBrew = mAlchemy->countPotionsToBrew();
+        const std::string suggested = mAlchemy->suggestPotionName();
+
+        {
+            std::ostringstream o;
+            o << "COMPANION_ALCHEMY_STATE_START:{"
+              << "\"factor\":" << factor
+              << ",\"chance\":" << chance
+              << ",\"skill\":" << alchemySkill
+              << ",\"wort\":" << fWortChanceValue
+              << ",\"maxBrew\":" << maxBrew
+              << ",\"brewCount\":" << mBrewCountEdit->getValue()
+              << ",\"ready\":" << ready
+              << ",\"name\":\"" << companionAlchemyJsonEscape(mNameEdit->getCaption().asUTF8()) << "\""
+              << ",\"suggested\":\"" << companionAlchemyJsonEscape(suggested) << "\"}";
+            Log(Debug::Info) << o.str();
+        }
+
+        // --- Apparatus slots, straight off the live mTools ---------------------------------------
+        // Read from the Alchemy object rather than derived, because the prefill is SESSION-STICKY:
+        // Alchemy::clear() deliberately does not clear mTools, so setAlchemist() re-selects whatever
+        // the player last hand-picked (while still owned) and only falls back to highest quality
+        // otherwise. That preference lives nowhere else and cannot be reconstructed.
+        {
+            int slot = 0;
+            for (auto it = mAlchemy->beginTools(); it != mAlchemy->endTools() && slot < 4; ++it, ++slot)
+            {
+                std::ostringstream o;
+                o << "COMPANION_ALCHEMY_APPARATUS:{\"slot\":" << slot;
+                if (it->isEmpty())
+                    o << ",\"present\":false}";
+                else
+                {
+                    const ESM::Apparatus* rec = it->get<ESM::Apparatus>()->mBase;
+                    o << ",\"present\":true"
+                      << ",\"id\":\"" << companionAlchemyJsonEscape(it->getCellRef().getRefId().serializeText()) << "\""
+                      << ",\"type\":" << rec->mData.mType
+                      << ",\"name\":\"" << companionAlchemyJsonEscape(rec->mName) << "\""
+                      << ",\"icon\":\"" << companionAlchemyJsonEscape(companionAlchemyIcon(rec->mIcon)) << "\""
+                      << ",\"quality\":" << rec->mData.mQuality << "}";
+                }
+                Log(Debug::Info) << o.str();
+            }
+        }
+
+        // --- Ingredient slots, IN PLACEMENT ORDER ------------------------------------------------
+        // Emitted per slot including the empty ones, so the bottom screen can render the gaps
+        // exactly where they are. Slot order is gameplay-significant (it decides the order of the
+        // created effects and therefore the order they apply when drunk), so it is never compacted.
+        {
+            int slot = 0;
+            for (auto it = mAlchemy->beginIngredients(); it != mAlchemy->endIngredients() && slot < 4; ++it, ++slot)
+            {
+                std::ostringstream o;
+                o << "COMPANION_ALCHEMY_SLOT:{\"slot\":" << slot;
+                if (it->isEmpty())
