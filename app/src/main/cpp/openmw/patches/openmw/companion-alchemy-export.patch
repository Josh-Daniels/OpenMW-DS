+                      << ",\"count\":" << item.getCellRef().getCount() << "}";
+                }
+                Log(Debug::Info) << o.str();
+            }
+        }
+
+        // --- Created effects ---------------------------------------------------------------------
+        // listEffects() order, unsorted, exactly as the native preview builds it. NAME + ICON ONLY:
+        // vanilla sets mIsConstant/mNoTarget/mNoMagnitude on every one of these, so no magnitude,
+        // duration or range is shown -- and the "known" test here is knownEffect(index), which is a
+        // DIFFERENT formula from the per-ingredient slot gate below. Unknown entries carry no name
+        // or icon; the bottom screen draws "?" for them, as MWSpellEffect does.
+        {
+            std::size_t idx = 0;
+            for (const MWMechanics::EffectKey& key : mAlchemy->listEffects())
