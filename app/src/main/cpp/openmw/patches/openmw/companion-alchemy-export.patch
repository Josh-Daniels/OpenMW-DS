+                    MWWorld::Ptr item = *it;
+                    o << ",\"present\":true"
+                      << ",\"id\":\"" << companionAlchemyJsonEscape(item.getCellRef().getRefId().serializeText()) << "\""
+                      << ",\"name\":\"" << companionAlchemyJsonEscape(item.getClass().getName(item)) << "\""
+                      << ",\"icon\":\"" << companionAlchemyJsonEscape(
