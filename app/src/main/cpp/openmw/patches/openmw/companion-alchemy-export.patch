+                    first = false;
+                    o << "{\"n\":\"" << companionAlchemyJsonEscape(effName) << "\""
+                      << ",\"ic\":\"" << companionAlchemyJsonEscape(effIcon) << "\""
+                      << ",\"k\":" << (known ? "true" : "false") << "}";
+                }
+                o << "]}";
+                Log(Debug::Info) << o.str();
+            }
+        }
+
+        Log(Debug::Info) << "COMPANION_ALCHEMY_STATE_END";
+    }
+
+    void AlchemyWindow::companionEmitClosed()
+    {
+        if (!gCompanionAlchemyOpen)
+            return;
+        gCompanionAlchemyOpen = false;
+        gCompanionAlchemyWindow = nullptr;
+        Log(Debug::Info) << "COMPANION_ALCHEMY_CLOSED";
+    }
+
+    void AlchemyWindow::onClose()
+    {
+        WindowBase::onClose();
+        // Only on the REAL mode-pop, never on the transient hide the DS suppression performs one
+        // frame after the window is pushed (containsMode is still true there). In DS mode this
+        // rarely fires at all -- the window is already hidden by then, so setVisible(false) produces
+        // no visible->hidden edge; exit() / onCancelButtonClicked cover that case.
+        if (!MWBase::Environment::get().getWindowManager()->containsMode(GM_Alchemy))
+            companionEmitClosed();
+    }
+
+    bool AlchemyWindow::exit()
+    {
+        // B / Escape. Unlike LevelupDialog there is deliberately NO refusal here: alchemy is
+        // genuinely cancellable in vanilla, and the DS screen keeps that. Emit the close signal and
+        // return true exactly as the base class did, so the mode pops as before.
+        companionEmitClosed();
+        return true;
+    }
+
+    void AlchemyWindow::companionSetApparatus(int slot, std::string_view refId)
+    {
+        MWWorld::Ptr player = MWMechanics::getPlayer();
+        if (player.isEmpty())
+            return;
+        MWWorld::ContainerStore& cstore = player.getClass().getContainerStore(player);
+        for (auto it = cstore.begin(MWWorld::ContainerStore::Type_Apparatus); it != cstore.end(); ++it)
+        {
+            if (it->getCellRef().getRefId().serializeText() != refId)
+                continue;
+
+            MWWorld::Ptr item = *it;
+            // The slot is derived from the RECORD, exactly as onItemSelected does -- an apparatus
+            // can only ever go in its own type's slot. The caller's slot is used only as a sanity
+            // filter so a stale command cannot land an alembic in the retort slot.
+            const int32_t index = item.get<ESM::Apparatus>()->mBase->mData.mType;
+            if (index < 0 || index >= static_cast<int32_t>(mApparatus.size()))
+                return;
+            if (slot >= 0 && slot != index)
+                return;
+
+            const auto& widget = mApparatus[index];
+            widget->setItem(item);
+            mAlchemy->addApparatus(item);
+            widget->setUserString("ToolTipType", "ItemPtr");
+            widget->setUserData(MWWorld::Ptr(item));
+            MWBase::Environment::get().getWindowManager()->playSound(item.getClass().getDownSoundId(item));
+            update();
+            return;
+        }
+    }
+
+    void AlchemyWindow::companionClearApparatus(int slot)
+    {
+        if (slot < 0 || slot >= static_cast<int>(mApparatus.size()))
+            return;
+        // The same body as onApparatusSelected's filled-slot branch.
+        const auto& widget = mApparatus[slot];
+        mAlchemy->removeApparatus(static_cast<std::size_t>(slot));
+
+        if (widget->getChildCount())
+            MyGUI::Gui::getInstance().destroyWidget(widget->getChildAt(0));
+
+        widget->clearUserStrings();
+        widget->setItem(MWWorld::Ptr());
+        widget->setUserData(MWWorld::Ptr());
+        update();
+    }
+
+    void AlchemyWindow::companionAddIngredient(std::string_view refId)
+    {
+        MWWorld::Ptr player = MWMechanics::getPlayer();
+        if (player.isEmpty())
+            return;
+        MWWorld::ContainerStore& cstore = player.getClass().getContainerStore(player);
+        for (auto it = cstore.begin(MWWorld::ContainerStore::Type_Ingredient); it != cstore.end(); ++it)
+        {
+            if (it->getCellRef().getRefId().serializeText() != refId)
+                continue;
+
+            MWWorld::Ptr item = *it;
+            // Alchemy::addIngredient owns both rejections -- no free slot, or an ingredient of this
+            // RefId already placed -- and returns -1 for either. Vanilla gives no feedback in that
+            // case and neither does this; the bottom screen simply never offers the row.
+            if (mAlchemy->addIngredient(item) != -1)
+            {
+                update();
+                MWBase::Environment::get().getWindowManager()->playSound(item.getClass().getUpSoundId(item));
+            }
+            return;
+        }
+    }
+
+    void AlchemyWindow::companionClearIngredient(int slot)
+    {
+        if (slot < 0 || slot >= static_cast<int>(mIngredients.size()))
+            return;
+        // The same body as onIngredientSelected. removeIngredient() blanks the slot in place, so
+        // the remaining ingredients keep their positions -- nothing is compacted, which matters
+        // because slot order decides the created-effect order.
+        mAlchemy->removeIngredient(static_cast<std::size_t>(slot));
+        update();
+    }
+
+    void AlchemyWindow::companionSetName(std::string_view text)
+    {
+        mNameEdit->setCaption(MyGUI::UString(std::string(text)));
+        // Re-publish: the name gates getReadyStatus() and therefore countPotionsToBrew(). update()
+        // is safe to call here -- it only overwrites the caption when the SUGGESTION changed, which
+        // typing cannot do, so a hand-typed name survives exactly as it does in vanilla.
+        update();
+    }
+
+    void AlchemyWindow::companionCreate(int count)
+    {
+        // Set the spinner and press the real button, so the min(countPotionsToBrew(), value) clamp,
+        // the validation order, the messages, the sounds and the per-potion roll are all the native
+        // ones. No upper bound is applied here on purpose: that native clamp is the authority, which
+        // is what makes an over-large count harmless. (The DS spinner caps itself at the craftable
+        // maximum as a UI affordance -- a divergence from vanilla's unbounded spinner -- so in
+        // practice it never sends more than the clamp would grant anyway.)
+        mBrewCountEdit->setValue(std::max(1, count));
+        onCreateButtonClicked(mCreateButton);
+    }
+
+    void AlchemyWindow::companionCancel()
+    {
+        onCancelButtonClicked(mCancelButton);
+    }
+
+// COMPANION: bottom-screen alchemy bridges, driven from drainCompanionCommands (androidmain.cpp) on
+// the engine main thread. Every one is a no-op unless an alchemy session is actually open, so a
+// stale command after the window closed cannot do anything.
+extern "C" void companionAlchemySetApparatus(int slot, const char* refId)
+{
+    if (!gCompanionAlchemyWindow || !refId)
+        return;
+    gCompanionAlchemyWindow->companionSetApparatus(slot, refId);
+}
+
+extern "C" void companionAlchemyClearApparatus(int slot)
+{
+    if (!gCompanionAlchemyWindow)
+        return;
+    gCompanionAlchemyWindow->companionClearApparatus(slot);
+}
+
+extern "C" void companionAlchemyAddIngredient(const char* refId)
+{
+    if (!gCompanionAlchemyWindow || !refId)
+        return;
+    gCompanionAlchemyWindow->companionAddIngredient(refId);
+}
+
+extern "C" void companionAlchemyClearIngredient(int slot)
+{
+    if (!gCompanionAlchemyWindow)
+        return;
+    gCompanionAlchemyWindow->companionClearIngredient(slot);
+}
+
+extern "C" void companionAlchemySetName(const char* text)
+{
+    if (!gCompanionAlchemyWindow || !text)
+        return;
+    gCompanionAlchemyWindow->companionSetName(text);
+}
+
+extern "C" void companionAlchemyCreate(int count)
+{
+    if (!gCompanionAlchemyWindow)
+        return;
+    gCompanionAlchemyWindow->companionCreate(count);
+}
+
+extern "C" void companionAlchemyCancel()
+{
+    if (!gCompanionAlchemyWindow)
+        return;
+    gCompanionAlchemyWindow->companionCancel();
+}
+#endif
 }
