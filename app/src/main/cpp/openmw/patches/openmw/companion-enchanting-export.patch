+    // ================= Companion (DS enchanting) =================
+    //
+    // PRESENTATION + INPUT FORWARDING ONLY. MWMechanics::Enchanting keeps every rule: the cast-style
+    // state machine, the accumulating per-effect cost, the enchant-points capacity check, the
+    // price / charge / success-chance formulas, the self-enchant roll and the soul-gem consumption
+    // that happens whatever the outcome. EffectEditorBase still owns the effect list, the 8-effect
+    // cap and the add-then-remove-on-cancel semantics.
+
+    // The range a NEW effect opens on.
+    //
+    // This is a faithful reproduction of vanilla's actual two-step behaviour, not a simplification:
+    //   1. EditEffectDialog::newEffect runs a cascade that consults allowSelf and allowTouch only
+    //      (allowTarget is never read there), and then
+    //   2. calls onRangeButtonClicked UNCONDITIONALLY, which advances one step and applies three
+    //      SEQUENTIAL (not else-if) legality checks in Self, Touch, Target order -- so a value can
+    //      be advanced more than once, and the final Target->Self wrap is never re-checked.
+    //
+    // Reproduced case by case (S/T/G = Self/Touch/Target allowed under the LIVE cast style):
+    //      S T G -> vanilla
+    //      1 1 1 -> Touch        1 1 0 -> Touch
+    //      1 0 1 -> Self         1 0 0 -> Self
+    //      0 1 1 -> Target  <== the one exception, see below
+    //      0 1 0 -> Self (ILLEGAL -- a genuine vanilla bug; step 2's final wrap lands on a range the
+    //                    effect does not allow, and nothing re-checks it)
+    //      0 0 1 -> Target       0 0 0 -> unreachable (rejected before the editor opens)
+    //
+    // THE ONE DELIBERATE EXCEPTION: Touch+Target-with-no-Self opens on TOUCH rather than vanilla's
+    // Target. That combination is the reported bug -- the cascade leaves Touch and the unconditional
+    // advance then steps past it onto Target, so the first range the player is offered is the last
+    // one they would expect. Nothing else here deviates.
+    //
+    // The 0/1/0 row is reproduced as-is even though the result is illegal: the DS editor's own
+    // range-legality guard corrects it to Touch as soon as the popup opens, so the faithful value
+    // never survives contact with the player, and hard-coding a second exception here would be a
+    // silent second divergence.
+    int EnchantingDialog::companionInitialRange(const ESM::MagicEffect* effect) const
+    {
+        if (!effect)
+            return ESM::RT_Self;
+
+        // Constant Effect force-allows Self and force-denies Touch/Target, exactly as both
+        // newEffect and onRangeButtonClicked compute it.
+        const bool constant = mEnchanting.getCastStyle() == ESM::Enchantment::ConstantEffect;
+        const bool allowSelf = (effect->mData.mFlags & ESM::MagicEffect::CastSelf) != 0 || constant;
+        const bool allowTouch = (effect->mData.mFlags & ESM::MagicEffect::CastTouch) && !constant;
+        const bool allowTarget = (effect->mData.mFlags & ESM::MagicEffect::CastTarget) && !constant;
+
+        // The exception, applied before the cascade so the rest stays a straight transcription.
+        if (!allowSelf && allowTouch && allowTarget)
+            return ESM::RT_Touch;
+
+        // Step 1 -- newEffect's cascade, verbatim (allowTarget deliberately not consulted).
+        int range = ESM::RT_Self;
+        if (!allowSelf)
+            range = ESM::RT_Touch;
+        if (!allowTouch)
+            range = ESM::RT_Target;
+
+        // Step 2 -- onRangeButtonClicked, verbatim: advance once, then three sequential checks.
+        range = (range + 1) % 3;
+        if (range == ESM::RT_Self && !allowSelf)
+            range = (range + 1) % 3;
+        if (range == ESM::RT_Touch && !allowTouch)
+            range = (range + 1) % 3;
+        if (range == ESM::RT_Target && !allowTarget)
+            range = (range + 1) % 3;
+
+        return range;
     }
+
+    int EnchantingDialog::companionFirstLegalRange(const ESM::MagicEffect* effect) const
+    {
+        if (!effect)
+            return ESM::RT_Self;
+        const bool constant = mEnchanting.getCastStyle() == ESM::Enchantment::ConstantEffect;
+        if ((effect->mData.mFlags & ESM::MagicEffect::CastSelf) || constant)
+            return ESM::RT_Self;
+        if ((effect->mData.mFlags & ESM::MagicEffect::CastTouch) && !constant)
+            return ESM::RT_Touch;
+        if ((effect->mData.mFlags & ESM::MagicEffect::CastTarget) && !constant)
+            return ESM::RT_Target;
+        return ESM::RT_Self;
+    }
+
+    bool EnchantingDialog::companionCastCyclable()
+    {
+        MWWorld::ConstPtr item = mEnchanting.getOldItem();
+        if (item.isEmpty())
+            return false;
+
+        const int soulForConstant = MWBase::Environment::get()
+                                        .getESMStore()
+                                        ->get<ESM::GameSetting>()
+                                        .find("iSoulAmountForConstantEffect")
+                                        ->mValue.getInteger();
+        const bool powerfulSoul = mEnchanting.getGemCharge() >= soulForConstant;
+
+        // The shape of Enchanting::nextCastStyle()'s per-item-class state machine.
+        const unsigned int type = item.getType();
+        if (type == ESM::Book::sRecordId)
+            return false; // scrolls/books are locked to Cast Once
+        if (type == ESM::Armor::sRecordId || type == ESM::Clothing::sRecordId)
+            return powerfulSoul; // WhenUsed <-> ConstantEffect, and only with a powerful soul
+        if (type == ESM::Weapon::sRecordId)
+        {
+            const int weaponType = item.get<ESM::Weapon>()->mBase->mData.mType;
+            const ESM::WeaponType::Class weapclass = MWMechanics::getWeaponType(weaponType)->mWeaponClass;
+            if (weapclass == ESM::WeaponType::Ammo || weapclass == ESM::WeaponType::Thrown)
+                return false; // locked to When Strikes, and Constant is explicitly excluded
+            if (weapclass == ESM::WeaponType::Ranged)
+                return powerfulSoul; // bows reach only When Used, unless a powerful soul unlocks Constant
+            return true; // melee: When Strikes <-> When Used (<-> Constant)
+        }
+        return false;
+    }
+
+    // The full state batch, streamed one small line per record: the two pickers' contents are
+    // bounded only by how much the player is carrying, so this must not ride a single line (the
+    // 4096-byte stdout-flush truncation would silently cut it).
+    void EnchantingDialog::companionEmitState()
+    {
+        if (!sEnchantingDialogCompanionOpen)
+            return;
+
+        const MWWorld::Ptr player = MWMechanics::getPlayer();
+        if (player.isEmpty())
+            return;
+
+        const MWWorld::ESMStore& store = *MWBase::Environment::get().getESMStore();
+        MWBase::WindowManager* winMgr = MWBase::Environment::get().getWindowManager();
+
+        // setPtr assigns mPtr = getPlayer() for the self-enchant (soul gem) entry point and the
+        // actor for the buy-from-an-enchanter one, which is exactly the mSelfEnchanting split.
+        const bool self = (mPtr == player);
+        const int castStyle = mEnchanting.getCastStyle();
+        const bool constant = castStyle == ESM::Enchantment::ConstantEffect;
+
+        const char* castGmst = "sItemCastOnce";
+        switch (castStyle)
+        {
+            case ESM::Enchantment::WhenStrikes: castGmst = "sItemCastWhenStrikes"; break;
+            case ESM::Enchantment::WhenUsed: castGmst = "sItemCastWhenUsed"; break;
+            case ESM::Enchantment::ConstantEffect: castGmst = "sItemCastConstant"; break;
+            default: break;
+        }
+
+        {
+            std::ostringstream o;
+            o << "COMPANION_ENCHANTING_STATE_START:{"
+              << "\"self\":" << (self ? "true" : "false")
+              << ",\"enchanter\":\"" << companionEnchantJsonEscape(self ? std::string{} : mPtr.getClass().getName(mPtr)) << "\""
+              << ",\"gold\":" << player.getClass().getContainerStore(player).count(MWWorld::ContainerStore::sGoldId)
+              << ",\"name\":\"" << companionEnchantJsonEscape(mName->getCaption().asUTF8()) << "\""
+              // int(getEnchantPoints(false)) -- the FLOORED-per-effect sum. This is what the native
+              // label shows AND what the Buy capacity check compares, and it is deliberately NOT the
+              // precise=true value used by the chance / item-count / type-multiplier paths.
+              << ",\"points\":" << static_cast<int>(mEnchanting.getEnchantPoints(false))
+              << ",\"maxPoints\":" << mEnchanting.getMaxEnchantValue()
+              << ",\"castCost\":" << mEnchanting.getEffectiveCastCost()
+              << ",\"charge\":" << mEnchanting.getGemCharge()
+              << ",\"price\":" << mEnchanting.getEnchantPrice()
+              << ",\"chance\":" << std::clamp(mEnchanting.getEnchantChance(), 0, 100)
+              // Price is shown only when buying; the success chance only when self-enchanting AND
+              // the engine's own "show enchant chance" setting is on -- the exact pair of
+              // conditions setPtr applies to mPrice/mPriceText and mChanceLayout. Exported rather
+              // than decided on the DS side so the screen tracks that setting if it is ever turned on.
+              << ",\"showPrice\":" << (self ? "false" : "true")
+              << ",\"showChance\":" << ((self && Settings::game().mShowEnchantChance) ? "true" : "false")
+              << ",\"castType\":" << castStyle
+              << ",\"castLabel\":\"" << companionEnchantJsonEscape(winMgr->getGameSettingString(castGmst, {})) << "\""
+              << ",\"castCycle\":" << (companionCastCyclable() ? "true" : "false")
+              << ",\"constant\":" << (constant ? "true" : "false")
+              << ",\"effectCap\":8}";
+            Log(Debug::Info) << o.str();
+        }
+
+        // --- Item slot ---------------------------------------------------------------------------
+        {
+            MWWorld::ConstPtr item = mEnchanting.getOldItem();
+            std::ostringstream o;
+            o << "COMPANION_ENCHANTING_ITEMSLOT:{";
+            if (item.isEmpty())
+                o << "\"present\":false}";
+            else
+                o << "\"present\":true"
+                  << ",\"id\":\"" << companionEnchantJsonEscape(item.getCellRef().getRefId().serializeText()) << "\""
+                  << ",\"name\":\"" << companionEnchantJsonEscape(item.getClass().getName(item)) << "\""
+                  << ",\"icon\":\"" << companionEnchantJsonEscape(companionEnchantIcon(item.getClass().getInventoryIcon(item))) << "\""
+                  << ",\"maxPoints\":" << mEnchanting.getMaxEnchantValue() << "}";
+            Log(Debug::Info) << o.str();
+        }
+
+        // --- Soul slot ---------------------------------------------------------------------------
+        {
+            MWWorld::ConstPtr gem = mEnchanting.getGem();
+            std::ostringstream o;
+            o << "COMPANION_ENCHANTING_SOULSLOT:{";
+            if (gem.isEmpty())
+                o << "\"present\":false}";
+            else
+            {
+                std::string soulName;
+                const ESM::Creature* soul = store.get<ESM::Creature>().search(gem.getCellRef().getSoul());
+                if (soul)
+                    soulName = soul->mName;
+                o << "\"present\":true"
+                  << ",\"id\":\"" << companionEnchantJsonEscape(gem.getCellRef().getRefId().serializeText()) << "\""
+                  << ",\"name\":\"" << companionEnchantJsonEscape(gem.getClass().getName(gem)) << "\""
+                  << ",\"icon\":\"" << companionEnchantJsonEscape(companionEnchantIcon(gem.getClass().getInventoryIcon(gem))) << "\""
+                  << ",\"soul\":\"" << companionEnchantJsonEscape(soulName) << "\""
+                  << ",\"charge\":" << mEnchanting.getGemCharge() << "}";
+            }
+            Log(Debug::Info) << o.str();
+        }
+
+        // --- Browse list: the effects the player can enchant with ---------------------------------
+        // mButtonMapping is EffectEditorBase::startEditing's snapshot -- the union of every effect
+        // appearing in any ST_Spell the player knows, filtered to AllowEnchanting, deduplicated by
+        // record and sorted by display name. It is rebuilt on every open by startEditing, which
+        // CLEARS the map first -- see that clear; without it this loop reports a stale tail as rows.
+        //
+        // The RAW flag word is exported, not precomputed booleans: which range options and which
+        // sliders are legal also depends on the LIVE cast style (Constant force-allows Self and
+        // force-denies Touch/Target, and hides Duration), which the player changes with the Type
+        // button while the browse list stands still.
+        for (const auto& [index, effectId] : mButtonMapping)
+        {
+            const ESM::MagicEffect* mgef = store.get<ESM::MagicEffect>().search(effectId);
+            if (!mgef)
+                continue;
+            std::ostringstream o;
+            o << "COMPANION_ENCHANTING_AVAIL:{"
+              << "\"id\":\"" << companionEnchantJsonEscape(effectId.serializeText()) << "\""
+              << ",\"name\":\"" << companionEnchantJsonEscape(mgef->mName) << "\""
+              << ",\"icon\":\"" << companionEnchantJsonEscape(companionEnchantIcon(mgef->mIcon)) << "\""
+              << ",\"flags\":" << mgef->mData.mFlags << "}";
+            Log(Debug::Info) << o.str();
+        }
+
+        // --- The effects currently on the enchantment ---------------------------------------------
+        // Emission order IS mEffects order, which is the order the DS addresses them by index.
+        {
+            int index = 0;
+            for (const ESM::ENAMstruct& effect : mEffects)
+            {
+                const ESM::MagicEffect* mgef = store.get<ESM::MagicEffect>().search(effect.mEffectID);
+                std::ostringstream o;
+                o << "COMPANION_ENCHANTING_EFFECT:{"
+                  << "\"index\":" << index
+                  << ",\"id\":\"" << companionEnchantJsonEscape(effect.mEffectID.serializeText()) << "\""
+                  << ",\"skill\":\"" << companionEnchantJsonEscape(effect.mSkill.serializeText()) << "\""
+                  << ",\"attribute\":\"" << companionEnchantJsonEscape(effect.mAttribute.serializeText()) << "\""
+                  << ",\"range\":" << effect.mRange
+                  << ",\"magMin\":" << effect.mMagnMin
+                  << ",\"magMax\":" << effect.mMagnMax
+                  << ",\"duration\":" << effect.mDuration
+                  << ",\"area\":" << effect.mArea
+                  << ",\"flags\":" << (mgef ? mgef->mData.mFlags : 0)
+                  << ",\"icon\":\"" << companionEnchantJsonEscape(mgef ? companionEnchantIcon(mgef->mIcon) : std::string{}) << "\""
+                  // Composed HERE, not on the Kotlin side -- see companionEnchantEffectLine.
+                  << ",\"text\":\"" << companionEnchantJsonEscape(companionEnchantEffectLine(effect, constant)) << "\"}";
+                Log(Debug::Info) << o.str();
+                ++index;
+            }
+        }
+
+        // --- Item picker contents ------------------------------------------------------------------
+        // SortFilterItemModel::Filter_OnlyEnchantable, verbatim: not already enchanted, and of a
+        // type that can carry an enchantment -- with Book accepted only when it is a scroll.
+        {
+            MWWorld::Ptr playerPtr = player;
+            MWWorld::ContainerStore& cstore = playerPtr.getClass().getContainerStore(playerPtr);
+            const int mask = MWWorld::ContainerStore::Type_Armor | MWWorld::ContainerStore::Type_Clothing
+                | MWWorld::ContainerStore::Type_Weapon | MWWorld::ContainerStore::Type_Book;
+            for (auto it = cstore.begin(mask); it != cstore.end(); ++it)
+            {
+                MWWorld::Ptr item = *it;
+                if (!item.getClass().getEnchantment(item).empty())
+                    continue;
+                if (item.getType() == ESM::Book::sRecordId && !item.get<ESM::Book>()->mBase->mData.mIsScroll)
+                    continue;
+                std::ostringstream o;
+                o << "COMPANION_ENCHANTING_ITEMOPT:{"
+                  << "\"id\":\"" << companionEnchantJsonEscape(item.getCellRef().getRefId().serializeText()) << "\""
+                  << ",\"name\":\"" << companionEnchantJsonEscape(item.getClass().getName(item)) << "\""
+                  << ",\"icon\":\"" << companionEnchantJsonEscape(companionEnchantIcon(item.getClass().getInventoryIcon(item))) << "\""
+                  << ",\"count\":" << item.getCellRef().getCount()
+                  // The capacity this item would give, so the picker can be chosen against the
+                  // effects already planned. Same source as the label: mData.mEnchant * fEnchantmentMult.
+                  << ",\"maxPoints\":" << static_cast<int>(item.getClass().getEnchantmentPoints(item)
+                         * store.get<ESM::GameSetting>().find("fEnchantmentMult")->mValue.getFloat()) << "}";
+                Log(Debug::Info) << o.str();
+            }
+        }
+
+        // --- Soul picker contents --------------------------------------------------------------------
+        // SortFilterItemModel::Filter_OnlyChargedSoulstones, verbatim: a Miscellaneous item whose
+        // CellRef carries a soul that resolves to a real creature record.
+        {
+            MWWorld::Ptr playerPtr = player;
+            MWWorld::ContainerStore& cstore = playerPtr.getClass().getContainerStore(playerPtr);
+            for (auto it = cstore.begin(MWWorld::ContainerStore::Type_Miscellaneous); it != cstore.end(); ++it)
+            {
+                MWWorld::Ptr gem = *it;
+                if (gem.getCellRef().getSoul().empty())
+                    continue;
+                const ESM::Creature* soul = store.get<ESM::Creature>().search(gem.getCellRef().getSoul());
+                if (!soul)
+                    continue;
+                std::ostringstream o;
+                o << "COMPANION_ENCHANTING_SOULOPT:{"
+                  << "\"id\":\"" << companionEnchantJsonEscape(gem.getCellRef().getRefId().serializeText()) << "\""
+                  << ",\"name\":\"" << companionEnchantJsonEscape(gem.getClass().getName(gem)) << "\""
+                  << ",\"icon\":\"" << companionEnchantJsonEscape(companionEnchantIcon(gem.getClass().getInventoryIcon(gem))) << "\""
+                  << ",\"soul\":\"" << companionEnchantJsonEscape(soul->mName) << "\""
+                  // The soul's raw mData.mSoul -- the same number getGemCharge() reports, NOT the
+                  // gem's own capacity.
+                  << ",\"charge\":" << soul->mData.mSoul << "}";
+                Log(Debug::Info) << o.str();
+            }
+        }
+
+        Log(Debug::Info) << "COMPANION_ENCHANTING_STATE_END";
+    }
