+    std::string EffectEditorBase::companionIcon(std::string_view raw)
+    {
+        if (raw.empty())
+            return {};
+        const VFS::Manager* const vfs = MWBase::Environment::get().getResourceSystem()->getVFS();
+        if (!vfs)
+            return {};
+        return Misc::ResourceHelpers::correctIconPath(VFS::Path::toNormalized(raw), *vfs);
+    }
