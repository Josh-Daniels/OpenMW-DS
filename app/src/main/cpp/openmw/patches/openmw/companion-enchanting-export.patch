+    // Raw ESM icon field -> the uniform VFS path the companion's icon pipeline expects.
+    void EffectEditorBase::companionEmitEffectLists(bool constant) const
+    {
+        const MWWorld::ESMStore& store = *MWBase::Environment::get().getESMStore();
+
+        // --- The magic-effect browse list ---------------------------------------------------------
+        // mButtonMapping, which startEditing() fills with the effects this screen allows (the
+        // AllowSpellmaking / AllowEnchanting split is made there, on mType), sorted by display name.
+        // It is rebuilt on every open by startEditing, which CLEARS the map first -- see that clear;
+        // without it this loop reports a stale tail as rows.
+        //
+        // The RAW flag word is exported, not precomputed booleans: which range options and which
+        // sliders are legal also depends on the LIVE constant-effect state, which enchanting's Type
+        // button changes while the browse list stands still.
+        for (const auto& [index, effectId] : mButtonMapping)
+        {
+            const ESM::MagicEffect* mgef = store.get<ESM::MagicEffect>().search(effectId);
+            if (!mgef)
+                continue;
+            std::ostringstream o;
+            o << companionSignalPrefix() << "AVAIL:{"
+              << "\"id\":\"" << companionJsonEscape(effectId.serializeText()) << "\""
+              << ",\"name\":\"" << companionJsonEscape(mgef->mName) << "\""
+              << ",\"icon\":\"" << companionJsonEscape(companionIcon(mgef->mIcon)) << "\""
+              << ",\"flags\":" << mgef->mData.mFlags << "}";
+            Log(Debug::Info) << o.str();
+        }
+
+        // --- The effects currently on the spell / enchantment --------------------------------------
+        // Emission order IS mEffects order, and that is load-bearing twice over: it is how the DS
+        // addresses an effect by index, and for SPELLMAKING it also decides the magicka cost, since
+        // notifyEffectsChanged's Target x1.5 multiplies the RUNNING TOTAL rather than the individual
+        // effect. Never sort this.
+        int index = 0;
+        for (const ESM::ENAMstruct& effect : mEffects)
+        {
+            const ESM::MagicEffect* mgef = store.get<ESM::MagicEffect>().search(effect.mEffectID);
+            std::ostringstream o;
+            o << companionSignalPrefix() << "EFFECT:{"
+              << "\"index\":" << index
+              << ",\"id\":\"" << companionJsonEscape(effect.mEffectID.serializeText()) << "\""
+              << ",\"skill\":\"" << companionJsonEscape(effect.mSkill.serializeText()) << "\""
+              << ",\"attribute\":\"" << companionJsonEscape(effect.mAttribute.serializeText()) << "\""
+              << ",\"range\":" << effect.mRange
+              << ",\"magMin\":" << effect.mMagnMin
+              << ",\"magMax\":" << effect.mMagnMax
+              << ",\"duration\":" << effect.mDuration
+              << ",\"area\":" << effect.mArea
+              << ",\"flags\":" << (mgef ? mgef->mData.mFlags : 0)
+              << ",\"icon\":\"" << companionJsonEscape(mgef ? companionIcon(mgef->mIcon) : std::string{}) << "\""
+              // Composed HERE, not on the Kotlin side -- see companionEffectLine.
+              << ",\"text\":\"" << companionJsonEscape(companionEffectLine(effect, constant)) << "\"}";
+            Log(Debug::Info) << o.str();
+            ++index;
+        }
+    }
