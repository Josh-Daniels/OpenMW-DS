+    // ---- Effects ---------------------------------------------------------------------------------
+
+    void EnchantingDialog::companionEffectAdd(std::string_view effectId)
+    {
+        // EffectEditorBase::onAvailableEffectClicked's gates, in its order.
+        if (mEffects.size() >= 8)
+        {
+            companionEnchantMessage(MWBase::Environment::get().getWindowManager(), "sNotifyMessage28");
+            return;
+        }
+
+        const ESM::RefId id = ESM::RefId::deserializeText(effectId);
+        const ESM::MagicEffect* effect = MWBase::Environment::get().getESMStore()->get<ESM::MagicEffect>().search(id);
+        if (!effect)
+            return;
+
+        const bool constant = mEnchanting.getCastStyle() == ESM::Enchantment::ConstantEffect;
+        const bool allowSelf = (effect->mData.mFlags & ESM::MagicEffect::CastSelf) != 0 || constant;
+        const bool allowTouch = (effect->mData.mFlags & ESM::MagicEffect::CastTouch) && !constant;
+        const bool allowTarget = (effect->mData.mFlags & ESM::MagicEffect::CastTarget) && !constant;
+        if (!allowSelf && !allowTouch && !allowTarget)
+            return; // silently unusable, matching vanilla's own unresolved TODO -- no message
+
+        // A skill- or attribute-targeted effect needs its argument chosen FIRST. Vanilla opens
+        // SelectSkillDialog / SelectAttributeDialog here; the DS screen draws that picker itself and
+        // answers with CMP:enchant_effect_skill / _attribute. Note there is deliberately NO
+        // duplicate check on this path -- vanilla has none, so the same skill may be added twice.
+        if (effect->mData.mFlags & ESM::MagicEffect::TargetSkill)
+        {
+            Log(Debug::Info) << "COMPANION_ENCHANTING_ARGPICK:{\"kind\":\"skill\",\"effect\":\""
+                             << companionEnchantJsonEscape(id.serializeText()) << "\"}";
+            return;
+        }
+        if (effect->mData.mFlags & ESM::MagicEffect::TargetAttribute)
+        {
+            Log(Debug::Info) << "COMPANION_ENCHANTING_ARGPICK:{\"kind\":\"attribute\",\"effect\":\""
+                             << companionEnchantJsonEscape(id.serializeText()) << "\"}";
+            return;
+        }
+
+        // Plain effects DO get the strict one-per-record check.
+        for (const ESM::ENAMstruct& existing : mEffects)
+        {
+            if (existing.mEffectID == id)
+            {
+                companionEnchantMessage(MWBase::Environment::get().getWindowManager(), "sOnetypeEffectMessage");
+                return;
+            }
+        }
+
+        companionBeginNewEffect(effect, ESM::RefId(), ESM::RefId());
+    }
+
+    void EnchantingDialog::companionEffectArg(std::string_view effectId, std::string_view argId, bool isSkill)
+    {
+        // The same two gates vanilla applies before it opens the skill/attribute picker; they are
+        // re-run here because the DS picker sits between the two halves of that flow.
+        if (mEffects.size() >= 8)
+        {
+            companionEnchantMessage(MWBase::Environment::get().getWindowManager(), "sNotifyMessage28");
+            return;
+        }
+        const ESM::RefId id = ESM::RefId::deserializeText(effectId);
+        const ESM::MagicEffect* effect = MWBase::Environment::get().getESMStore()->get<ESM::MagicEffect>().search(id);
+        if (!effect)
+            return;
+        const bool constant = mEnchanting.getCastStyle() == ESM::Enchantment::ConstantEffect;
+        const bool allowSelf = (effect->mData.mFlags & ESM::MagicEffect::CastSelf) != 0 || constant;
+        const bool allowTouch = (effect->mData.mFlags & ESM::MagicEffect::CastTouch) && !constant;
+        const bool allowTarget = (effect->mData.mFlags & ESM::MagicEffect::CastTarget) && !constant;
+        if (!allowSelf && !allowTouch && !allowTarget)
+            return;
+
+        const ESM::RefId arg = ESM::RefId::deserializeText(argId);
+        if (isSkill)
+            companionBeginNewEffect(effect, arg, ESM::RefId());
+        else
+            companionBeginNewEffect(effect, ESM::RefId(), arg);
+    }
+
+    void EnchantingDialog::companionBeginNewEffect(
+        const ESM::MagicEffect* effect, const ESM::RefId& skill, const ESM::RefId& attribute)
+    {
+        // Route through the REAL EditEffectDialog::newEffect, so eventEffectAdded fires and the
+        // effect is in mEffects the moment the DS editor opens -- vanilla's add-then-remove-on-
+        // cancel behaviour, which the top-screen live readout depends on. The modal itself is
+        // suppressed (setCompanionSuppressed), so nothing appears on the top screen.
+        mAddEffectDialog.setCompanionSuppressed(companionSuppressModals());
+        mAddEffectDialog.newEffect(effect);
+        if (!skill.empty())
+            mAddEffectDialog.setSkill(skill);
+        else if (!attribute.empty())
+            mAddEffectDialog.setAttribute(attribute);
+
+        if (mEffects.empty())
+            return;
+
+        // The opening range. newEffect has already run vanilla's own two steps and written their
+        // result through eventEffectModified; this replaces it with companionInitialRange, which
+        // reproduces those same two steps EXCEPT for the single Touch+Target case (see there).
+        ESM::ENAMstruct& added = mEffects.back();
+        added.mRange = companionInitialRange(effect);
+        if (added.mRange == ESM::RT_Self)
+            added.mArea = 0; // as onRangeButtonClicked zeroes the area slider when it lands on Self
+
+        mCompanionEditIndex = static_cast<int>(mEffects.size()) - 1;
+        mCompanionEditIsNew = true;
+        mCompanionOldEffect = added;
+
+        updateEffectsView();
+        Log(Debug::Info) << "COMPANION_ENCHANTING_EDIT:{\"index\":" << mCompanionEditIndex << ",\"new\":true}";
+    }
+
+    void EnchantingDialog::companionEffectEdit(int index)
+    {
+        if (index < 0 || index >= static_cast<int>(mEffects.size()))
+            return;
+        // Snapshot for _effect_cancel, mirroring EditEffectDialog::mOldEffect.
+        mCompanionEditIndex = index;
+        mCompanionEditIsNew = false;
+        mCompanionOldEffect = mEffects[index];
+        Log(Debug::Info) << "COMPANION_ENCHANTING_EDIT:{\"index\":" << index << ",\"new\":false}";
+    }
+
+    void EnchantingDialog::companionEffectSet(int index, int range, int magMin, int magMax, int duration, int area)
+    {
+        if (index < 0 || index >= static_cast<int>(mEffects.size()))
+            return;
+
+        ESM::ENAMstruct effect = mEffects[index];
+        const ESM::MagicEffect* mgef
+            = MWBase::Environment::get().getESMStore()->get<ESM::MagicEffect>().search(effect.mEffectID);
+
+        // The slider bounds are FIXED constants in openmw_edit_effect.layout and never adjusted at
+        // runtime: Magnitude 1..100 (pos+1), Duration 1..1440 (pos+1), Area 0..50 (pos, no offset).
+        // Clamped here as well as on the DS side so a malformed command cannot write out of range.
+        magMin = std::clamp(magMin, 1, 100);
+        magMax = std::clamp(magMax, 1, 100);
+        if (magMax < magMin)
+            magMax = magMin; // the only coupling: onMagnitudeMaxChanged forces max >= min
+        duration = std::clamp(duration, 1, 1440);
+        area = std::clamp(area, 0, 50);
+
+        // Keep the range legal under the live cast style.
+        const bool constant = mEnchanting.getCastStyle() == ESM::Enchantment::ConstantEffect;
+        const int flags = mgef ? mgef->mData.mFlags : 0;
+        const bool ok = (range == ESM::RT_Self && ((flags & ESM::MagicEffect::CastSelf) || constant))
+            || (range == ESM::RT_Touch && (flags & ESM::MagicEffect::CastTouch) && !constant)
+            || (range == ESM::RT_Target && (flags & ESM::MagicEffect::CastTarget) && !constant);
+        if (!ok)
+            range = companionFirstLegalRange(mgef); // a repair, not an opening choice
+        if (range == ESM::RT_Self)
+            area = 0;
+
+        effect.mRange = range;
+        effect.mMagnMin = magMin;
+        effect.mMagnMax = magMax;
+        effect.mDuration = duration;
+        effect.mArea = area;
+        mEffects[index] = effect;
+
+        updateEffectsView();
+    }
+
+    void EnchantingDialog::companionEffectDelete(int index)
+    {
+        if (index < 0 || index >= static_cast<int>(mEffects.size()))
+            return;
+        mEffects.erase(mEffects.begin() + index);
+        if (mCompanionEditIndex == index)
+        {
+            mCompanionEditIndex = -1;
+            mCompanionEditIsNew = false;
+        }
+        else if (mCompanionEditIndex > index)
+            --mCompanionEditIndex;
+        mSelectedEffect = 0;
+        updateEffectsView();
+    }
+
+    void EnchantingDialog::companionEffectOk()
+    {
+        // OK: keep what the sliders wrote and forget the snapshot.
+        mCompanionEditIndex = -1;
+        mCompanionEditIsNew = false;
+    }
+
+    void EnchantingDialog::companionEffectCancel()
+    {
+        // The two halves of EditEffectDialog::exit(): a NEW effect is removed outright, an edited
+        // one is restored to the values it had when the editor opened.
+        if (mCompanionEditIndex < 0 || mCompanionEditIndex >= static_cast<int>(mEffects.size()))
+        {
+            mCompanionEditIndex = -1;
+            mCompanionEditIsNew = false;
+            return;
+        }
+        if (mCompanionEditIsNew)
+            mEffects.erase(mEffects.begin() + mCompanionEditIndex);
+        else
+            mEffects[mCompanionEditIndex] = mCompanionOldEffect;
+        mCompanionEditIndex = -1;
+        mCompanionEditIsNew = false;
+        mSelectedEffect = 0;
+        updateEffectsView();
+    }
+
+    void EnchantingDialog::companionCastTypeNext()
+    {
+        // The real handler: nextCastStyle() + updateLabels() + updateEffectsView(). updateLabels
+        // calls setConstantEffect(), which on the switch INTO Constant force-rewrites every
+        // already-added effect's range to Self -- and does not restore them on the way back out.
+        // That destructive side effect is vanilla's and is deliberately preserved.
+        onTypeButtonClicked(mTypeButton);
+    }
+
+    void EnchantingDialog::companionBuy()
+    {
+        // The real handler, so all seven validations run in their exact order with their exact
+        // messages, the stolen-item confiscation still happens, and the self-enchant roll (which
+        // consumes the soul gem whatever the outcome) is the engine's.
+        onBuyButtonClicked(mBuyButton);
+    }
+
+    void EnchantingDialog::companionCancel()
+    {
+        onCancelButtonClicked(mCancelButton);
+    }
