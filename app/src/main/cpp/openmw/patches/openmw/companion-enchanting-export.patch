+    // COMPANION: the effect's display line, composed HERE rather than on the Kotlin side.
+    //
+    // This is a faithful transcription of Widgets::MWSpellEffect::updateWidgets (widgets.cpp) --
+    // getMagicEffectString plus a magnitude-display-type switch and eleven GMSTs. It lives in C++
+    // beside the original so the DS readout cannot drift from the wording vanilla shows two feet
+    // away on the top screen. The ONLY difference: the "#{sin}"/"#{sfootarea}" tags that vanilla
+    // leaves for setCaptionWithReplacing are resolved here, since this string is emitted, not set
+    // as a MyGUI caption.
+    //
+    // The parameters mNoTarget / mNoMagnitude / mKnown are omitted because EffectEditorBase::
+    // updateEffectsView never sets them -- only mIsConstant, which IS handled.
+    std::string EffectEditorBase::companionEffectLine(const ESM::ENAMstruct& effect, bool constant)
+    {
+        const MWWorld::ESMStore& store = *MWBase::Environment::get().getESMStore();
+        const ESM::MagicEffect* magicEffect = store.get<ESM::MagicEffect>().search(effect.mEffectID);
+        if (!magicEffect)
+            return {};
+        const ESM::Attribute* attribute = store.get<ESM::Attribute>().search(effect.mAttribute);
+        const ESM::Skill* skill = store.get<ESM::Skill>().search(effect.mSkill);
+
+        MWBase::WindowManager* winMgr = MWBase::Environment::get().getWindowManager();
+        const std::string_view pt = winMgr->getGameSettingString("spoint", {});
+        const std::string_view pts = winMgr->getGameSettingString("spoints", {});
+        const std::string_view pct = winMgr->getGameSettingString("spercent", {});
+        const std::string_view ft = winMgr->getGameSettingString("sfeet", {});
+        const std::string_view lvl = winMgr->getGameSettingString("sLevel", {});
+        const std::string_view lvls = winMgr->getGameSettingString("sLevels", {});
+        const std::string to = " " + std::string{ winMgr->getGameSettingString("sTo", {}) } + " ";
+        const std::string sec = " " + std::string{ winMgr->getGameSettingString("ssecond", {}) };
+        const std::string secs = " " + std::string{ winMgr->getGameSettingString("sseconds", {}) };
+
+        std::string line = MWMechanics::getMagicEffectString(*magicEffect, attribute, skill);
+
+        if (effect.mMagnMin || effect.mMagnMax)
+        {
+            const ESM::MagicEffect::MagnitudeDisplayType displayType = magicEffect->getMagnitudeDisplayType();
+            if (displayType == ESM::MagicEffect::MDT_TimesInt)
+            {
+                std::ostringstream formatter;
+                formatter << std::fixed << std::setprecision(1) << " " << (effect.mMagnMin / 10.0f);
+                if (effect.mMagnMin != effect.mMagnMax)
+                    formatter << to << (effect.mMagnMax / 10.0f);
+                formatter << winMgr->getGameSettingString("sXTimesINT", {});
+                line += formatter.str();
+            }
+            else if (displayType != ESM::MagicEffect::MDT_None)
+            {
+                line += " " + std::to_string(effect.mMagnMin);
+                if (effect.mMagnMin != effect.mMagnMax)
+                    line += to + std::to_string(effect.mMagnMax);
+
+                if (displayType == ESM::MagicEffect::MDT_Percentage)
+                    line += pct;
+                else if (displayType == ESM::MagicEffect::MDT_Feet)
+                {
+                    line += ' ';
+                    line += ft;
+                }
+                else if (displayType == ESM::MagicEffect::MDT_Level)
+                {
+                    line += ' ';
+                    line += (effect.mMagnMin == effect.mMagnMax && std::abs(effect.mMagnMin) == 1) ? lvl : lvls;
+                }
+                else // MDT_Points
+                {
+                    line += ' ';
+                    line += (effect.mMagnMin == effect.mMagnMax && std::abs(effect.mMagnMin) == 1) ? pt : pts;
+                }
+            }
+        }
+
+        // Constant effects have no duration and no target -- vanilla's own comment.
+        if (!constant)
+        {
+            int duration = effect.mDuration;
+            if (!(magicEffect->mData.mFlags & ESM::MagicEffect::AppliedOnce))
+                duration = std::max(1, duration);
+
+            if (duration > 0 && !(magicEffect->mData.mFlags & ESM::MagicEffect::NoDuration))
+            {
+                line += ' ';
+                line += winMgr->getGameSettingString("sfor", {});
+                line += ' ' + std::to_string(duration) + ((duration == 1) ? sec : secs);
+            }
+
+            if (effect.mArea > 0)
+            {
+                line += ' ';
+                line += winMgr->getGameSettingString("sin", {});
+                line += ' ' + std::to_string(effect.mArea) + ' ';
+                line += winMgr->getGameSettingString("sfootarea", {});
+            }
+
+            line += ' ';
+            line += winMgr->getGameSettingString("sonword", {});
+            line += ' ';
+            if (effect.mRange == ESM::RT_Self)
+                line += winMgr->getGameSettingString("sRangeSelf", {});
+            else if (effect.mRange == ESM::RT_Touch)
+                line += winMgr->getGameSettingString("sRangeTouch", {});
+            else if (effect.mRange == ESM::RT_Target)
+                line += winMgr->getGameSettingString("sRangeTarget", {});
+        }
+
+        return line;
     }
