+
+    void EnchantingDialog::companionSelectItem(std::string_view refId)
+    {
+        MWWorld::Ptr player = MWMechanics::getPlayer();
+        if (player.isEmpty())
+            return;
+        MWWorld::ContainerStore& cstore = player.getClass().getContainerStore(player);
+        const int mask = MWWorld::ContainerStore::Type_Armor | MWWorld::ContainerStore::Type_Clothing
+            | MWWorld::ContainerStore::Type_Weapon | MWWorld::ContainerStore::Type_Book;
+        for (auto it = cstore.begin(mask); it != cstore.end(); ++it)
+        {
+            MWWorld::Ptr item = *it;
+            if (item.getCellRef().getRefId().serializeText() != refId)
+                continue;
+            // Re-check the picker's own filter here: the bottom screen could be acting on a stale
+            // list (the item was enchanted or dropped since the batch was sent).
+            if (!item.getClass().getEnchantment(item).empty())
+                return;
+            if (item.getType() == ESM::Book::sRecordId && !item.get<ESM::Book>()->mBase->mData.mIsScroll)
+                return;
+
+            // onItemSelected's body, minus the mItemSelectionDialog->setVisible(false) -- that
+            // dialog is never constructed in DS mode. setItem() also overwrites the name field with
+            // the item's own name, exactly as vanilla does on every item selection.
+            setItem(item);
+            MWBase::Environment::get().getWindowManager()->playSound(item.getClass().getDownSoundId(item));
+            mEnchanting.nextCastStyle();
+            updateLabels();
+            return;
+        }
+    }
+
+    void EnchantingDialog::companionClearItem()
+    {
+        // onSelectItem's filled-slot branch. Deliberately asymmetric with the soul clear below:
+        // clearing the item does NOT re-run nextCastStyle() or refresh the effects view.
+        setItem(MWWorld::Ptr());
+        updateLabels();
+    }
+
+    void EnchantingDialog::companionSelectSoul(std::string_view refId)
+    {
+        MWWorld::Ptr player = MWMechanics::getPlayer();
+        if (player.isEmpty())
+            return;
+        const MWWorld::ESMStore& store = *MWBase::Environment::get().getESMStore();
+        MWWorld::ContainerStore& cstore = player.getClass().getContainerStore(player);
+        for (auto it = cstore.begin(MWWorld::ContainerStore::Type_Miscellaneous); it != cstore.end(); ++it)
+        {
+            MWWorld::Ptr gem = *it;
+            if (gem.getCellRef().getRefId().serializeText() != refId)
+                continue;
+            if (gem.getCellRef().getSoul().empty() || !store.get<ESM::Creature>().search(gem.getCellRef().getSoul()))
+                return;
+
+            // onSoulSelected's body, minus the dialog hide. The zero-charge rejection is kept even
+            // though the picker filter makes it unreachable, so the two cannot drift.
+            mEnchanting.setSoulGem(gem);
+            if (mEnchanting.getGemCharge() == 0)
+            {
+                companionEnchantMessage(MWBase::Environment::get().getWindowManager(), "sNotifyMessage32");
+                return;
+            }
+            setSoulGem(gem);
+            MWBase::Environment::get().getWindowManager()->playSound(gem.getClass().getDownSoundId(gem));
+            updateLabels();
+            return;
+        }
+    }
+
+    void EnchantingDialog::companionClearSoul()
+    {
+        // onSelectSoul's filled-slot branch -- which, unlike the item clear, DOES re-run the cast
+        // style (losing the soul can put Constant Effect out of reach) and refresh the effects view.
+        setSoulGem(MWWorld::Ptr());
+        mEnchanting.nextCastStyle();
+        updateLabels();
+        updateEffectsView();
+    }
+
+    void EnchantingDialog::companionSetName(std::string_view text)
+    {
+        mName->setCaption(MyGUI::UString(std::string(text)));
+        updateLabels();
+    }
