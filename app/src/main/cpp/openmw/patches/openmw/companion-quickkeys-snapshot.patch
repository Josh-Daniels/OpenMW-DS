+    // OpenMW-DS: rebuild the quick slot snapshot. One line per slot, "index|type|name|icon", where
+    // type is ESM::QuickKeys::Type as a number and icon is a VFS path (empty when there is none).
+    // Called at the end of every path that changes a slot.
+    void QuickKeysMenu::companionUpdateSnapshot()
+    {
+        const VFS::Manager& vfs = *MWBase::Environment::get().getResourceSystem()->getVFS();
+        const MWWorld::ESMStore& esmStore = *MWBase::Environment::get().getESMStore();
+        std::string out;
+        for (const keyData& key : mKey)
+        {
+            std::string icon;
+            switch (key.type)
+            {
+                case ESM::QuickKeys::Type::Item:
+                case ESM::QuickKeys::Type::MagicItem:
+                {
+                    const MWWorld::Ptr* item = key.button->getUserData<MWWorld::Ptr>(false);
+                    if (item != nullptr && !item->isEmpty())
+                        icon = Misc::ResourceHelpers::correctIconPath(
+                            VFS::Path::toNormalized(item->getClass().getInventoryIcon(*item)), vfs)
+                                   .value();
+                    break;
+                }
+                case ESM::QuickKeys::Type::Magic:
+                {
+                    const ESM::Spell* spell = esmStore.get<ESM::Spell>().search(key.id);
+                    if (spell != nullptr && !spell->mEffects.mList.empty())
+                    {
+                        const ESM::MagicEffect* effect = esmStore.get<ESM::MagicEffect>().search(
+                            spell->mEffects.mList.front().mData.mEffectID);
+                        if (effect != nullptr)
+                            icon = Misc::ResourceHelpers::correctIconPath(
+                                VFS::Path::toNormalized(effect->mIcon), vfs)
+                                       .value();
+                    }
+                    break;
+                }
+                case ESM::QuickKeys::Type::HandToHand:
+                    icon = "icons/k/stealth_handtohand.dds";
+                    break;
+                case ESM::QuickKeys::Type::Unassigned:
+                    break;
+            }
+            std::string name = key.name;
+            std::replace(name.begin(), name.end(), '|', ' ');
+            std::replace(name.begin(), name.end(), '\n', ' ');
+            out += std::to_string(key.index) + '|' + std::to_string(static_cast<int>(key.type)) + '|' + name + '|'
+                + icon + '\n';
+        }
+        std::lock_guard<std::mutex> lock(gCompanionQuickKeysMutex);
+        gCompanionQuickKeys = std::move(out);
+    }
+
