--- a/apps/openmw/mwrender/renderingmanager.cpp
+++ b/apps/openmw/mwrender/renderingmanager.cpp
@@ -1,5 +1,7 @@
 #include "renderingmanager.hpp"
 
+#include <chrono>
+#include <cmath>
 #include <cstdlib>
 #include <limits>
 
@@ -441,6 +443,45 @@
     {
         mAmbientColor = colour;
         updateAmbient();
+
+#ifdef __ANDROID__
+        // Companion: export the scene's ambient luminance so the bottom screen can dim itself to
+        // match how dark the game world is (its UI renders at a fixed brightness, so in a cave it
+        // otherwise looks much brighter than the top screen).
+        //
+        // This is THE choke point for scene ambient: the only two callers are
+        // MWWorld::WeatherManager::update (exteriors — already folds in time of day and weather)
+        // and RenderingManager::configureAmbient (interiors — cell mood, already past the
+        // Settings::shaders().mMinimumInteriorBrightness clamp). So one hook covers
+        // interior/exterior, time-of-day and weather without separate exports.
+        //
+        // Same Rec.709 relative-luminance weights configureAmbient itself uses just above its
+        // call, so the exported number matches the engine's own notion of "how bright is this".
+        {
+            constexpr float pR = 0.2126f;
+            constexpr float pG = 0.7152f;
+            constexpr float pB = 0.0722f;
+            const float luminance = pR * colour.r() + pG * colour.g() + pB * colour.b();
+
+            // THROTTLED: the weather system calls this EVERY FRAME, so an unguarded emit would
+            // flood the JNI bridge and the Kotlin parser at 60Hz. Emit only on a meaningful
+            // change AND at most a few times a second; the companion animates between values, so
+            // a coarse feed is enough. Drift accumulates against sLastEmitted (not the previous
+            // frame), so a slow dusk ramp still reports once it crosses the threshold.
+            static float sLastEmitted = -1.f;
+            static std::chrono::steady_clock::time_point sLastEmitTime{};
+            constexpr float kMinChange = 0.02f;
+            constexpr auto kMinInterval = std::chrono::milliseconds(250);
+
+            const auto now = std::chrono::steady_clock::now();
+            if (std::fabs(luminance - sLastEmitted) >= kMinChange && (now - sLastEmitTime) >= kMinInterval)
+            {
+                sLastEmitted = luminance;
+                sLastEmitTime = now;
+                Log(Debug::Info) << "COMPANION_AMBIENT:" << luminance;
+            }
+        }
+#endif
     }
 
