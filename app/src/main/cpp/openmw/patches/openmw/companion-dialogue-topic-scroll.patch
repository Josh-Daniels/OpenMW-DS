+
+    void MWList::scrollToItem(size_t index)
+    {
+        // redraw() creates exactly one widget per item, in item order, so the child index and the
+        // item index line up. Bail out if that is not (yet) true rather than guessing a position.
+        if (index >= mItems.size() || index >= mScrollView->getChildCount())
+            return;
+
+        const int viewHeight = mScrollView->getViewCoord().height;
+        if (viewHeight <= 0)
+            return;
+
+        // The widget is positioned inside the item's vertical padding, so add it back on both
+        // sides: an item counts as visible only when its padding is visible too.
+        const MyGUI::Widget* item = mScrollView->getChildAt(index);
+        const int padding = mItems[index].mVPadding;
+        const int top = item->getTop() - padding;
+        const int bottom = item->getTop() + item->getHeight() + padding;
+
+        // NB the view offset is negative; work in positive scroll positions and scroll by the
+        // smallest amount that makes the item fully visible.
+        int position = -mScrollView->getViewOffset().top;
+        if (top < position)
+            position = top;
+        else if (bottom > position + viewHeight)
+            position = bottom - viewHeight;
+
+        setScrollPosition(position);
+    }
+
+    void MWList::scrollToBottom()
+    {
+        setScrollPosition(mScrollView->getCanvasSize().height);
+    }
+
+    void MWList::setScrollPosition(int position)
+    {
+        const int maxPosition = std::max(0, mScrollView->getCanvasSize().height - mScrollView->getViewCoord().height);
+        mScrollView->setViewOffset(MyGUI::IntPoint(0, -std::clamp(position, 0, maxPosition)));
+    }
 }
