+
+    std::string companionMapJsonEscape(std::string_view sv)
+    {
+        std::string out;
+        out.reserve(sv.size() + 8);
+        for (const char c : sv)
+        {
+            switch (c)
+            {
+                case '"': out += "\\\""; break;
+                case '\\': out += "\\\\"; break;
+                case '\n': out += "\\n"; break;
+                case '\r': out += "\\r"; break;
+                case '\t': out += "\\t"; break;
+                default: out += c; break;
+            }
+        }
+        return out;
+    }
