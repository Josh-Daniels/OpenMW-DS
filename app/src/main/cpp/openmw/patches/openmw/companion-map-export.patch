+    // ================= Companion (DS map) =================
+    //
+    // The DS map replaces the native window ONLY on the app-controlled maximize path
+    // (companion minimap tap -> CMP:openmap). The combined GM_Inventory view and the pinned HUD
+    // map are deliberately untouched; the suppression flag is mount-scoped, so it is false in both.
+    //
+    // Everything here is a PUSH of engine state. Nothing about the map is reimplemented: the global
+    // map imagery is the engine's own two CPU images, fog is the engine's own per-segment alpha
+    // mask, notes go through CustomMarkerCollection, and the discovered-location clustering is the
+    // native barycentre aggregation, exported already-computed rather than re-derived on the far
+    // side (same reasoning as the Enchanting effect display line).
+
+    void MapWindow::companionExportGlobal()
+    {
+        if (!mGlobalMapRender)
+            return;
+        mGlobalMapRender->ensureLoaded();
+
+        const int w = mGlobalMapRender->getWidth();
+        const int h = mGlobalMapRender->getHeight();
+        if (w <= 0 || h <= 0)
+            return;
+
+        // BASE: GL_RGB, static, built once from the ESM land data. Measured 954x864 for
+        // Morrowind+Tribunal+Bloodmoon => ~2.36 MB, so it ships in ONE piece; tiling would only be
+        // needed past roughly 1400x1400, which takes a worldspace-expanding mod to reach.
+        if (const osg::Image* base = mGlobalMapRender->companionBaseImage())
+            if (base->data() && base->s() == w && base->t() == h)
+                companionDeliverGlobalMapBase(w, h, mGlobalMapRender->companionMinX(),
+                    mGlobalMapRender->companionMinY(), Settings::map().mGlobalMapCellSize,
+                    base->getPixelFormat() == GL_RGB ? 3 : 4, base->data());
+
+        // OVERLAY: GL_RGBA, the explored layer. Zero-filled at load; exploreCell blits each
+        // discovered cell in. Sent WHOLE rather than as deltas because it cannot change while the
+        // DS map is up (see companionExportAll).
+        if (const osg::Image* ov = mGlobalMapRender->companionOverlayImage())
+            if (ov->data() && ov->s() == w && ov->t() == h)
+                companionDeliverGlobalMapOverlay(w, h, ov->data());
+    }
+
+    void MapWindow::companionEnsureLocalMaps()
+    {
+        // WITHOUT THIS, CELLS THE PLAYER HAS EXPLORED RENDER AS SOLID BLACK ON THE DS MAP.
+        //
+        // A segment's fog image is created in LocalMap::requestExteriorMap, and the only thing
+        // that calls it for a cell OTHER than the one the player stands in is
+        // LocalMapBase::updateRequiredMaps -- which walks mMaps and skips any entry that is
+        // invisible or `widgetCropped`. In DS mode this window is hidden, so every entry is
+        // skipped and no neighbour ever gets a fog image. companion-localmap-export.patch already
+        // force-renders the eight neighbours' IMAGERY past that same filter; this is the other
+        // half, and it has to exist separately because that patch runs per cell-change while this
+        // needs the whole viewing-distance grid, not just the 3x3.
+        //
+        // The consumer draws imagery-without-fog as solid black on purpose (no fog mask cannot be
+        // read as "fully explored" -- that would be a free reveal), so the missing half shows up
+        // as explored cells going black, typically the row and column the player has not walked
+        // into. Opening the vanilla map fixed it precisely because doing so un-crops those widgets
+        // and lets updateRequiredMaps run.
+        //
+        // This is the SAME call updateRequiredMaps makes, so the outcome is the engine's own and
+        // an already-explored cell gets its SAVED fog back (requestExteriorMap prefers
+        // cell->getFog() and only falls back to a fully-opaque initFogOfWar). Fog is created
+        // synchronously inside that call, so companionExportFog can read it in the same pass; the
+        // imagery is an RTT and lands a frame or two later through the existing capture callback.
+        //
+        // Exteriors only, mirroring updateRequiredMaps' own guard: an interior's segments and
+        // their fog are all set up by requestInteriorMap/updatePlayer in one go, so there is
+        // nothing per-cell to request.
+        //
+        // Cheap despite the getExterior() calls: this runs once per DS-map mount, and only for
+        // cells that are missing fog -- the steady state after the first open is a no-op.
+        if (!mLocalMapRender || !mActiveCell || !mActiveCell->isExterior())
+            return;
+        for (int x = mGrid.left; x <= mGrid.right; ++x)
+        {
+            for (int y = mGrid.top; y <= mGrid.bottom; ++y)
+            {
+                if (mLocalMapRender->getFogOfWarTexture(x, y))
+                    continue;
+                requestMapRender(&MWBase::Environment::get().getWorldModel()->getExterior(
+                    ESM::ExteriorCellLocation(x, y, ESM::Cell::sDefaultWorldspaceId)));
+            }
+        }
+    }
+
+    void MapWindow::companionExportFog()
+    {
+        if (!mLocalMapRender)
+            return;
+        // Every segment currently on the local map, i.e. exactly what the player can see. The fog
+        // image is 32x32 RGBA but only ALPHA carries information -- LocalMap::updatePlayer writes
+        // `val = alpha << 24` and never touches RGB -- so only the alpha plane is sent: 1024 bytes
+        // per segment instead of 4096, and it lands straight in an ALPHA_8 Bitmap.
+        // NOTE the Y bounds: MyGUI::IntRect is a SCREEN rect, so createRect() builds it as
+        // {top = centreY - radius, bottom = centreY + radius} -- `top` holds the MINIMUM and
+        // `bottom` the MAXIMUM. Iterating bottom..top is an empty range, which is exactly the bug
+        // this loop had: no fog was ever exported. Both of the engine's own segment loops walk
+        // mGrid.top -> mGrid.bottom, and so does this one.
+        for (int x = mGrid.left; x <= mGrid.right; ++x)
+        {
+            for (int y = mGrid.top; y <= mGrid.bottom; ++y)
+            {
+                osg::ref_ptr<osg::Texture2D> tex = mLocalMapRender->getFogOfWarTexture(x, y);
+                if (!tex)
+                    continue;
+                const osg::Image* img = tex->getImage();
+                if (!img || !img->data())
+                    continue;
+                const int fw = img->s(), fh = img->t();
+                std::vector<unsigned char> alpha(static_cast<size_t>(fw) * fh);
+                const unsigned char* src = img->data();
+                for (size_t i = 0; i < alpha.size(); ++i)
+                    alpha[i] = src[i * 4 + 3];
+                // LocalMap keeps mInterior private and exposes no getter; LocalMapBase already
+                // knows which kind of cell is active, and the two cannot disagree -- the
+                // segment maps are switched by the same cell change.
+                const int isInterior = (mActiveCell && !mActiveCell->isExterior()) ? 1 : 0;
+                companionDeliverMapFog(x, y, isInterior, fw, fh, alpha.data());
+            }
+        }
+    }
+
+    void MapWindow::companionExportNotes()
+    {
+        mCompanionNotes.clear();
+        Log(Debug::Info) << "COMPANION_MAP_NOTES_START";
+        // Walked in the SAME order the export index refers to, so an index the DS side sends back
+        // addresses the marker it was shown.
+        for (auto it = mCustomMarkers.begin(); it != mCustomMarkers.end(); ++it)
+        {
+            const ESM::CustomMarker& m = it->second;
+            std::ostringstream o;
+            // Is this note an EXTERIOR one (world map) or an interior one (local map)? Derived by
+            // asking what cell id this note's own position WOULD generate as an exterior and
+            // comparing -- no RefId type introspection needed, and it cannot disagree with how
+            // companionAddNote files them.
+            const ESM::ExteriorCellLocation nloc = ESM::positionToExteriorCellLocation(m.mWorldX, m.mWorldY);
+            const bool nExt = (m.mCell == ESM::Cell::generateIdForCell(true, {}, nloc.mX, nloc.mY));
+            o << "COMPANION_MAP_NOTE:{\"i\":" << mCompanionNotes.size()
+              << ",\"ext\":" << (nExt ? "true" : "false")
+              << ",\"x\":" << m.mWorldX << ",\"y\":" << m.mWorldY
+              << ",\"cell\":\"" << companionMapJsonEscape(m.mCell.serializeText()) << "\""
+              << ",\"note\":\"" << companionMapJsonEscape(m.mNote) << "\"}";
+            Log(Debug::Info) << o.str();
+            mCompanionNotes.push_back(m);
+        }
+        Log(Debug::Info) << "COMPANION_MAP_NOTES_END";
     }
 
+    void MapWindow::companionExportPlaces()
+    {
+        // The discovered-location markers, exported ALREADY CLUSTERED. addVisitedLocation builds
+        // MyGUI widgets directly and aggregates same-named locations onto their barycentre, scaling
+        // the widget by how many were merged -- there is no list to read, so mGlobalMapMarkers (the
+        // aggregation result) is what gets walked. Re-deriving that clustering on the Kotlin side
+        // would be a second implementation free to drift from this one.
+        Log(Debug::Info) << "COMPANION_MAP_PLACES_START";
+        for (const auto& entry : mGlobalMapMarkers)
+        {
+            const MapMarkerType& marker = entry.first;
+            if (!marker.widget)
+                continue;
+            std::ostringstream o;
+            o << "COMPANION_MAP_PLACE:{"
+              << "\"x\":" << marker.position.x() << ",\"y\":" << marker.position.y()
+              << ",\"n\":" << entry.second.size()
+              // RESOLVED, not the raw user string. createMarker stores the caption as the MyGUI
+              // tag "#{sCell=<name>}", and OpenMW's own handler (WindowManager::onRetrieveTag)
+              // turns that into translateCellName(<name>) — so replaceTags is what produces the
+              // name a player should see, correctly localised. Exporting the raw string put
+              // "#{sCell=Ebonheart}" on screen; stripping the wrapper in Kotlin instead would have
+              // hard-coded a tag format and skipped the translation.
+              << ",\"name\":\"" << companionMapJsonEscape(MyGUI::LanguageManager::getInstance()
+                     .replaceTags(MyGUI::UString(std::string(
+                         marker.widget->getUserString("Caption_TextOneLine")))).asUTF8()) << "\""
+              << ",\"vis\":" << (marker.widget->getVisible() ? "true" : "false") << "}";
+            Log(Debug::Info) << o.str();
+        }
+        Log(Debug::Info) << "COMPANION_MAP_PLACES_END";
+    }
+
+    void MapWindow::companionExportAll()
+    {
+        // ONE full push per DS-map mount. GM_Inventory is a GUI mode, so the sim is paused for as
+        // long as the DS map is up: the player cannot move, no cell can be explored, no fog texel
+        // can change and no marker can appear except through the DS note commands below (each of
+        // which re-exports). A full snapshot is therefore not merely simpler than live deltas -- it
+        // is complete.
+        const MWWorld::Ptr player = MWMechanics::getPlayer();
+        std::ostringstream o;
+        o << "COMPANION_MAP_STATE:{"
+          << "\"interior\":" << ((mActiveCell && !mActiveCell->isExterior()) ? "true" : "false")
+          // Exported as explicit MIN/MAX rather than MyGUI's left/top/right/bottom: in an
+          // IntRect `top` is the minimum Y and `bottom` the maximum (screen convention), which
+          // reads backwards for cell coordinates and is what made the consumer loop empty.
+          << ",\"gridXMin\":" << mGrid.left << ",\"gridXMax\":" << mGrid.right
+          << ",\"gridYMin\":" << mGrid.top << ",\"gridYMax\":" << mGrid.bottom
+          << ",\"cellSize\":" << cellSize;
+        if (!player.isEmpty())
+        {
+            const osg::Vec3f pos = player.getRefData().getPosition().asVec3();
+            o << ",\"px\":" << pos.x() << ",\"py\":" << pos.y();
+        }
+        o << "}";
+        Log(Debug::Info) << o.str();
+
+        companionEnsureLocalMaps();
+        companionExportGlobal();
+        companionExportFog();
+        companionExportNotes();
+        companionExportPlaces();
+        Log(Debug::Info) << "COMPANION_MAP_END";
+    }
+
+    void MapWindow::companionAddNote(float worldX, float worldY, bool exterior, std::string_view note)
+    {
+        if (!mActiveCell)
+            return;
+        // The cell a world position belongs to. The marker store is keyed BY CELL, so getting this
+        // wrong files the note somewhere it will never be drawn.
+        //
+        // `exterior` is forced true for a note dropped on the WORLD map, and that is not a
+        // convenience: getCellIdInWorldSpace returns mActiveCell->getId() whenever the active cell
+        // is an interior, IGNORING x/y — so long-pressing the world map while standing indoors
+        // would file an exterior position under the interior you happen to be in.
+        ESM::CustomMarker marker;
+        marker.mWorldX = worldX;
+        marker.mWorldY = worldY;
+        if (exterior || mActiveCell->isExterior())
+        {
+            const ESM::ExteriorCellLocation loc = ESM::positionToExteriorCellLocation(worldX, worldY);
+            marker.mCell = ESM::Cell::generateIdForCell(true, {}, loc.mX, loc.mY);
+        }
+        else
+            marker.mCell = mActiveCell->getId();
+        marker.mNote = std::string(note);
+        mCustomMarkers.addMarker(marker);
+        companionExportNotes();
+    }
+
+    void MapWindow::companionEditNote(int index, std::string_view note)
+    {
+        if (index < 0 || index >= static_cast<int>(mCompanionNotes.size()))
+            return;
+        // updateMarker (not delete+add): it is the collection's own edit path and keeps the
+        // marker's identity, so the eventMarkersChanged consumers see an update rather than a
+        // remove followed by an unrelated insert.
+        mCustomMarkers.updateMarker(mCompanionNotes[index], std::string(note));
+        companionExportNotes();
+    }
+
+    void MapWindow::companionDeleteNote(int index)
+    {
+        if (index < 0 || index >= static_cast<int>(mCompanionNotes.size()))
+            return;
+        mCustomMarkers.deleteMarker(mCompanionNotes[index]);
+        companionExportNotes();
+    }
+
+    void EditNoteDialog::setVisible(bool visible)
+    {
+        // COMPANION: never show this modal while the DS map owns note editing. Gated here rather
+        // than at the call sites so every path is covered. Hiding is always allowed, so a dialog
+        // already up when the element flips can still be dismissed.
+        if (visible && companionDsMapActive())
+            return;
+        WindowModal::setVisible(visible);
+    }
+
+// COMPANION: DS map bridges, driven from drainCompanionCommands on the engine main thread. Each is
+// a no-op unless the map window exists, so a stale command can do nothing.
+extern "C" void companionMapExportAll()
+{
+    if (gCompanionMapWindow)
