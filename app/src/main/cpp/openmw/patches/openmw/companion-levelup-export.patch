+#ifdef __ANDROID__
+    // COMPANION: cancel-and-defer. This USED to return !companionDsLevelUp(), i.e. refuse to close
+    // in DS mode, on the belief that popping the mode would LOSE the level-up. That belief was
+    // wrong and the refusal is gone.
+    //
+    // Nothing about levelling is applied until NpcStats::levelUp(), whose ONLY caller anywhere in
+    // the engine is onOkButtonClicked. So popping the mode any other way applies no attributes and
+    // no health, leaves mLevelProgress untouched (still above iLevelUpTotal), and the next sleep
+    // re-triggers the whole screen via WaitDialog::onWaitingFinished. onOpen() clears
+    // mSpentAttributes and resets the coins, so the re-opened window is clean. That is exactly what
+    // vanilla does when the player presses Escape, which has always closed this window.
+    //
+    // We still override rather than inherit WindowBase::exit() so the DS bridge pointer is dropped
+    // on a cancel, the same way onOkButtonClicked drops it on a commit -- otherwise a stray
+    // CMP:levelup_ok arriving after the window closed would reach a live LevelupDialog and could
+    // commit a level-up with no screen open. onOpen() re-publishes it on the next level-up.
+    //
+    // The bottom screen is NOT left stranded: popGuiMode fires the Lua UiModeChanged event, and
+    // companion.lua's LevelUp close edge emits COMPANION_LEVELUP_CLOSED for every exit that pops
+    // the mode, not just the native commit's removeGuiMode.
+    bool LevelupDialog::exit()
+    {
+        gCompanionLevelupDialog = nullptr;
+        return true;
+    }
+#endif
