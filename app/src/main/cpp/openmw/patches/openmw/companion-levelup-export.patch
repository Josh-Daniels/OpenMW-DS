+#ifdef __ANDROID__
+extern "C" bool companionDsLevelUp();
+
+    // COMPANION: the no-exit rule, for DS mode only.
+    //
+    // Vanilla never needs this: LevelupDialog::onControllerButtonEvent returns true for EVERY
+    // button, so B is swallowed before it can reach exitCurrentGuiMode. But controllermanager only
+    // calls that handler when `topWin->isVisible()`, and DS mode HIDES this window -- so in DS mode
+    // B would fall straight through to exit(), whose base implementation returns true, and the
+    // player would silently lose the level-up. Refusing here restores "B does nothing".
+    //
+    // Returning false normally makes exitCurrentGuiMode fall back to opening the pause menu; that
+    // escape hatch is suppressed for this case in windowmanagerimp.cpp, so B is a true no-op rather
+    // than a way to bounce out to the main menu.
+    //
+    // VANILLA mode is unaffected: the window is visible, the controller handler still eats B first,
+    // and this returns true exactly as the base class did.
+    bool LevelupDialog::exit()
+    {
+        return !companionDsLevelUp();
+    }
+#endif
+
+#ifdef __ANDROID__
+// COMPANION: bottom-screen level-up bridges, driven from drainCompanionCommands (androidmain.cpp)
+// on the engine main thread. These call the window's OWN handlers, so selection semantics (toggle,
+// replace-last-at-quota), the coin-count gate and the whole ordered commit -- level-progress
+// reduction, clearing the per-attribute skill-increase counters, the Endurance-dependent health
+// gain and setLevel(+1) -- all stay exactly where they were. Nothing about levelling is
+// reimplemented on the companion side.
+//
+// The pick takes the attribute's serialized ID rather than an ordinal on purpose: the bottom screen
+// builds its grid from core.stats.Attribute.records while this window builds from the ESM attribute
+// store, and an ID cannot silently pick the wrong attribute if those two ever iterate differently.
+extern "C" void companionLevelupPick(const char* attrId)
+{
+    if (!gCompanionLevelupDialog || !attrId)
+        return;
+    gCompanionLevelupDialog->companionPickAttribute(attrId);
+}
+
+extern "C" void companionLevelupOk()
+{
+    if (!gCompanionLevelupDialog)
+        return;
+    gCompanionLevelupDialog->companionConfirm();
+}
+#endif
