+#ifdef __ANDROID__
+    // COMPANION: the AUTHORITATIVE selection, echoed after every pick (and on open). The bottom
+    // screen renders from this rather than mirroring the toggle/replace-last rules itself, so the
+    // two can never disagree about what is actually selected -- this window remains the single
+    // source of truth for selection state, exactly as it is for the commit.
+    // Payload: "<coinCount>|<attrId>,<attrId>,..." (the id list may be empty).
+    void LevelupDialog::companionEmitSelection() const
+    {
+        std::string ids;
+        for (const auto& attribute : mSpentAttributes)
+        {
+            if (!ids.empty())
+                ids += ',';
+            // serializeText(), NOT getValue(): RefId::serializeText LOWERCASES a StringRefId
+            // (refid.cpp), and that is the form the bottom screen's own attribute ids arrive in
+            // (Lua's Attribute.record.id is serializeText too). getValue() returns the ESM's
+            // original casing ("Strength"), which never matched Lua's "strength" -- so the picks
+            // worked (the id is resolved case-insensitively) while nothing ever showed as selected.
+            ids += ESM::RefId{ attribute }.serializeText();
+        }
+        Log(Debug::Info) << "COMPANION_LEVELUP_SELECTION:" << mCoinCount << "|" << ids;
+    }
+
+    // COMPANION: pick by attribute id. Routes through the window's own onAttributeClicked so the
+    // toggle / replace-last-at-quota semantics are the native ones, not a copy.
+    void LevelupDialog::companionPickAttribute(std::string_view attrId)
+    {
+        // StringRefId interns case-insensitively, so this matches whatever casing the bottom
+        // screen sent.
+        const ESM::Attribute::AttributeID id{ attrId };
+        const auto it = mAttributeWidgets.find(id);
+        if (it == mAttributeWidgets.end() || it->second.mButton == nullptr)
+            return;
+        // An attribute already at 100 has its button disabled in onOpen, and MyGUI would never
+        // deliver a click to it. Re-check here so a stray command cannot do what a tap cannot.
+        if (!it->second.mButton->getEnabled())
+            return;
+        onAttributeClicked(it->second.mButton);
+    }
+
+    // COMPANION: confirm. Deliberately the SAME entry point as the native OK button, so the
+    // under-quota case still shows the vanilla "#{sNotifyMessage36}" message box and refuses,
+    // and the commit runs untouched.
+    void LevelupDialog::companionConfirm()
+    {
+        onOkButtonClicked(mOkButton);
+    }
+#endif
