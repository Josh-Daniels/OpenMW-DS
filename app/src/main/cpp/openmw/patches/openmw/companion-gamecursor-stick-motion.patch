@@ -27,6 +27,15 @@
 // Hide UI is active; used below to keep the gamepad GUI cursor suppressed so the
 // left thumbstick can't re-summon it over barter/map/service windows.
 extern "C" bool companionHudEnabled();
+// COMPANION: defined in androidmain.cpp. Returns false while the "Game cursor" option is off. Used
+// below to suppress the gamepad GUI cursor (thumbstick -> cursor motion) so the stick can't move an
+// invisible cursor when the option is off, and to force controller menus into highlight-navigation
+// mode (A activates the highlighted item). Touch-to-click is a separate path and is unaffected.
+extern "C" bool companionCursorEnabled();
+// COMPANION: also declared by companion-controller-nav.patch (applied AFTER this one). Redeclared
+// here so this patch does not depend on a later patch for a symbol it uses; identical redeclaration
+// of a function is legal, and this keeps the two patches independently resettable.
+extern "C" bool companionNavActive();
 #endif
 
 namespace MWInput
@@ -93,7 +102,21 @@
 
