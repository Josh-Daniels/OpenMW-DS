+        if (mGuiCursorEnabled && !(mJoystickLastUsed && !mGamepadGuiCursorEnabled)
+#ifdef __ANDROID__
+            // COMPANION: don't let the thumbstick move the GUI cursor while the "Game cursor" option
+            // is off — this is the cursor-movement source. Menu navigation still works via the d-pad
+            // highlight path, and touch-to-click is a separate input path (unaffected).
+            && companionCursorEnabled()
+            // COMPANION: nor while a DS overlay owns navigation. That overlay's native window is
+            // HIDDEN, so this block would steer a cursor nothing can see, and its setCursorActive(
+            // true) below re-shows it on the top screen. Gating the whole block (rather than the one
+            // guilty axis) also covers any future axis leak: gamepadToGuiControl swallows LEFTX /
+            // RIGHTX / RIGHTY under companionNavActive but NOT LEFTY, which reaches the
+            // A_MoveForwardBackward channel this block reads as yAxis -> vertical-only cursor drift.
+            && !companionNavActive()
+#endif
+        )
         {
             float xAxis = mBindingsManager->getActionValue(A_MoveLeftRight) * 2.0f - 1.0f;
             float yAxis = mBindingsManager->getActionValue(A_MoveForwardBackward) * 2.0f - 1.0f;
