 namespace MWGui
 {
+#ifdef __ANDROID__
+    // COMPANION: the controller button-hint bar's on/off state (the "Controller tooltips" HUD
+    // toggle), owned by androidmain.cpp. At namespace scope because block-scope extern "C" does not
+    // compile.
+    extern "C" bool companionHudControllerTooltips();
+
+    // Height of ControllerButtonsOverlay, from openmw_controllerbuttons.layout. A constant rather
+    // than a query because the overlay is private to WindowManager and this file is otherwise
+    // untouched by any patch.
+    static constexpr int sCompanionControllerBarHeight = 48;
+
+    // COMPANION: force the window to fit the screen. The layout's MinSize is 640x550, but this app
+    // holds the MyGUI canvas at 960x540 (see applyGuiScalingForTier), so the window could never be
+    // shorter than the screen and its bottom (the OK button included) ran off the edge. Upstream's
+    // WindowBase::clampWindowCoordinates cannot rescue it either: it returns early whenever the
+    // MINIMUM size exceeds the view, which is exactly this case. So lower the minimum to what the
+    // screen can hold, then clamp size and position, leaving room for the controller hint bar when
+    // it is showing (it is drawn over the bottom of the screen and would hide the OK button).
+    void SettingsWindow::companionFitToScreen()
+    {
+        auto* window = mMainWidget->castType<MyGUI::Window>();
+        MyGUI::IntSize viewSize = MyGUI::RenderManager::getInstance().getViewSize();
+        if (window->getLayer())
+            viewSize = window->getLayer()->getSize();
+
+        int availableHeight = viewSize.height;
+        if (Settings::gui().mControllerMenus && companionHudControllerTooltips())
+            availableHeight -= sCompanionControllerBarHeight;
+        if (viewSize.width <= 0 || availableHeight <= 0)
+            return;
+
+        MyGUI::IntSize minSize = window->getMinSize();
+        minSize.width = std::min(minSize.width, viewSize.width);
+        minSize.height = std::min(minSize.height, availableHeight);
+        window->setMinSize(minSize);
+
+        const MyGUI::IntCoord current = window->getCoord();
+        MyGUI::IntCoord fitted = current;
+        fitted.width = std::min(fitted.width, viewSize.width);
+        fitted.height = std::min(fitted.height, availableHeight);
+        fitted.left = std::clamp(fitted.left, 0, viewSize.width - fitted.width);
+        fitted.top = std::clamp(fitted.top, 0, availableHeight - fitted.height);
+        if (fitted == current)
+            return;
+
+        window->setCoord(fitted);
+        // setCoord does not raise this event (only a drag does). Raising it re-lays the controls
+        // tab (onWindowResize) and lets WindowManager save the corrected geometry to settings.cfg,
+        // so the next session starts on screen too.
+        window->eventWindowChangeCoord(window);
+    }
+#endif
